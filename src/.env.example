# Plantilla unica de variables de entorno. Copiar a src/.env y ajustar.
#   cp src/.env.example src/.env
# Docker Compose la consume con:  docker compose --env-file src/.env up

# --- Infraestructura Docker (puertos y certificados) ---
HTTP_PORT=8080            # Puerto anfitrión para HTTP  (anfitrión:contenedor 80)
HTTPS_PORT=443            # Puerto anfitrión para HTTPS (anfitrión:contenedor 443)
SSL_CERTS_DIR=./certs     # Directorio con server.crt y server.key (montado en /etc/nginx/ssl)
DB_PORT=3306              # Puerto anfitrión para MySQL

# --- MySQL: base de datos y credenciales del servidor ---
DB_NAME=fharina_et_ignis  # Base de datos que crea MySQL al iniciar
DB_ROOT_PASSWORD=contraseña_root  # Password del usuario root de MySQL
MYSQL_USER=usuario        # Usuario adicional que crea MySQL al iniciar
MYSQL_PASSWORD=contraseña_usuario # Password del usuario adicional

# --- App PHP: credenciales con las que se conecta la aplicación ---
# phpdotenv lee este mismo archivo (src/.env) y Database.php usa DB_*.
DB_SERVICE=mysql                    # motor (DSN)
DB_HOST=db                          # host de MySQL dentro de docker compose
DB_USER=root                        # usuario con el que la app se conecta
DB_PASSWORD=contraseña_root         # debe coincidir con DB_ROOT_PASSWORD
TICKET_DEBUG_HTML=0                 # 1 = volcar el HTML del ticket a /tmp/ticket_debug.html

# --- Integraciones externas (opcional) ---
# PayPal: modo sandbox para pruebas (api-m.sandbox.paypal.com) o live.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_API_SECRET=
# Clave de Google Maps Platform (Maps JavaScript + Geocoding + Distance Matrix).
# Sin ella el checkout a domicilio no geocodifica y los mapas no se dibujan.
GOOGLE_MAPS_API_KEY=
# Secreto compartido entre la app PHP y el relay WebSocket (contenedor "ws").
# Lar el mismo valor en WS_SECRET del relay; el archivo es el mismo src/.env.
WS_SECRET=

# --- Correo (SMTP). Vacío = no se envían correos.
# Para desarrollo usar el contenedor mailpit: host mailpit, puerto 1025, sin auth.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ignis.local
MAIL_FROM_NAME="Fharina et Ignis"
MAIL_TO=contacto@ignis.local
